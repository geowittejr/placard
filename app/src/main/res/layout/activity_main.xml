<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif-medium"
            android:gravity="top|start"
            android:hint="@string/message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="280"
            android:minLines="3"
            android:padding="18dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_muted"
            android:textSize="22sp" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_style" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/style_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp" />
        </HorizontalScrollView>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_display" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_fit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/mode_fit"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/mode_ticker"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/mode_ticker"
                android:textSize="15sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/max_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/max_brightness"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/show"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/show"
            android:textColor="@color/on_brand"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/save_phrase"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/save_phrase"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="28dp"
            android:text="@string/section_phrases" />

        <TextView
            android:id="@+id/phrases_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phrases_empty"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/phrase_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/tip"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
